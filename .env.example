# Copie para .env e preencha a DATABASE_URL.
# Toda variável nova também deve ser declarada em /src/config/environment.ts.
#
# O .env não vai para o Git. As URLs do Neon estão em "Banco de dados" no
# Confluence do projeto.

NODE_ENV="development"
PORT=3001
DATABASE_URL="postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require"
