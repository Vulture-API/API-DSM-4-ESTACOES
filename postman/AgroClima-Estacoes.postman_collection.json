                  "  pm.expect(corpo.meta).to.be.an('object');",
                  "});",
                  "pm.test('meta segue o contrato', () => {",
                  "  pm.expect(corpo.meta).to.have.all.keys('total_records', 'total_pages', 'current_page');",
                  "});",
                  "pm.test('limit é respeitado', () => pm.expect(corpo.data.length).to.be.at.most(5));",
